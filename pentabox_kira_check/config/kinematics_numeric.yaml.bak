## Pentabox family — NUMERIC Euclidean point (only d stays symbolic → FireFly reconstructs
## univariate rational functions in d; fast, sidesteps the multivariate GCD that stalled FAIR).
##
## Scalar-product table from fair_pentabox/CHECKPOINT.md (explicit rational Euclidean momenta,
## GramDet(p1..p4) = -9, genuine 4d).  It reproduces the six pole invariants exactly:
##   m2sq=(p2)^2=-5 ; s12=(p1+p2)^2=-7 ; m23sq=(p2+p3)^2=-14 ;
##   s123=(p1+p2+p3)^2=-13 ; m5sq=(p1+p2+p3+p4)^2=-24 ; s15=(p2+p3+p4)^2=-26
## (and the pole-irrelevant m3sq=-45, m4sq=-3, s34=-33), i.e. exactly the pentabox_kira_TASK point
##   {m2^2,s12,m23^2,s123,m5^2,s15} = {-5,-7,-14,-13,-24,-26}.
## p5 = -(p1+p2+p3+p4) eliminated by momentum conservation; p1^2=0.
kinematics:
  incoming_momenta: [p1,p2,p3,p4,p5]
  outgoing_momenta: []
  momentum_conservation: [p5,-p1-p2-p3-p4]
  kinematic_invariants: []
  scalarproduct_rules:
     - [[p1,p1],  0]
     - [[p1,p2], -1]
     - [[p1,p3],  3/2]
     - [[p1,p4],  1/2]
     - [[p2,p2], -5]
     - [[p2,p3],  18]
     - [[p2,p4], -12]
     - [[p3,p3], -45]
     - [[p3,p4],  15/2]
     - [[p4,p4], -3]
